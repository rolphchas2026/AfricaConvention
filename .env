# ========== SHARED DATABASE ==========
PORT=3001
DATABASE_URL=postgresql://postgres:<your-password>@db.dwhnmiqjgebhyrbdkyho.supabase.co:5432/postgres
DB_HOST=db.dwhnmiqjgebhyrbdkyho.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<your-password>
DB_NAME=postgres

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Africa2026!

# ========== ALFIO CONFIGURATION ==========
ALFIO_MODE=dev
ALFIO_SECURITY_FORCE_HTTPS=false
ALFIO_DATABASE_TYPE=POSTGRESQL
ALFIO_DATASOURCE_URL=jdbc:postgresql://shared-db:5432/africa_convention
ALFIO_DATASOURCE_USERNAME=admin
ALFIO_DATASOURCE_PASSWORD=ArushaPassword2026

# ========== QR CHECK-IN SYSTEM ==========
NODE_ENV=production
PORT=3000
ADMIN_KEY=africa_convention_2026_secret_key
API_TIMEOUT=30000
CORS_ORIGIN=*

# ========== INTEGRATION SETTINGS ==========
ALFIO_VERIFICATION=true
ALFIO_API_URL=http://alfio:8080
QR_API_URL=http://qr-api:3000

# ========== DASHBOARD ==========
DASHBOARD_PORT=4000
REACT_APP_API_URL=http://localhost:3000
REACT_APP_ALFIO_URL=http://localhost:9090

# ========== LOGGING ==========
LOG_LEVEL=info
LOG_DIR=/app/logs

# ========== EVENT DETAILS ==========
EVENT_NAME=2026 Africa Convention
EVENT_THEME=Doing Business and Bearing Fruitful
EVENT_DATE=18-22 June 2026
EVENT_VENUE=Arusha, Tanzania
EVENT_LOCATION=Living Hope Mission Center

# ========== OPTIONAL: SSL/HTTPS ==========
ENABLE_HTTPS=false
SSL_CERT_PATH=/etc/nginx/certs/cert.pem
SSL_KEY_PATH=/etc/nginx/certs/key.pem

# ========== SECURITY ==========
SESSION_SECRET=your_secure_session_secret_here_change_in_production
JWT_SECRET=your_jwt_secret_key_here_change_in_production
